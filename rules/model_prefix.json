{
  "_说明": "成楷 PPE 型号命名规则：CK{品类字母}-{编号}[后缀]。引擎用它做“型号前缀 ↔ 品类”自洽校验。allowed_categories 第一个为主品类。",
  "pattern": "^CK[A-Z]-[0-9A-Z][0-9A-Z\\-]*$",
  "prefixes": {
    "CKH": { "name": "呼吸防护", "examples": "防尘/防毒半面具、全面具、口罩、滤盒滤棉", "allowed_categories": ["呼吸防护"] },
    "CKY": { "name": "眼部防护", "examples": "护目镜、防护眼镜、防护眼罩", "allowed_categories": ["眼部防护", "焊接防护"] },
    "CKL": { "name": "面部防护", "examples": "防护面屏、电焊面罩、面屏支架", "allowed_categories": ["面部防护", "焊接防护"] },
    "CKB": { "name": "身体防护", "examples": "焊工皮具（手套/套袖/护膝/披肩面罩）、雨衣、围裙、防化服、安全带", "allowed_categories": ["身体防护", "焊接防护", "坠落防护"], "note": "CKB 覆盖面较宽，品牌方后续可能细分" },
    "CKS": { "name": "手部防护", "examples": "防切割、隔热、浸胶、一次性手套", "allowed_categories": ["手部防护"] },
    "CKT": { "name": "头部防护", "examples": "安全帽、防尘帽、防撞帽", "allowed_categories": ["头部防护"] },
    "CKE": { "name": "听力防护", "examples": "耳塞、耳罩、耳塞分配器", "allowed_categories": ["听力防护"] },
    "CKF": { "name": "足部防护", "examples": "安全鞋、雨靴、鞋套", "allowed_categories": ["足部防护"] }
  },
  "category_keywords": {
    "呼吸防护": ["口罩", "面具", "呼吸", "防毒", "防尘", "滤盒", "滤棉", "粉尘", "烟尘", "有机", "甲醛", "喷漆", "农药"],
    "眼部防护": ["护目镜", "眼镜", "眼罩", "眼睛", "飞屑", "防风沙"],
    "面部防护": ["面屏", "面罩", "护脸"],
    "焊接防护": ["焊", "弧光", "遮光"],
    "手部防护": ["手套", "防切割", "防割", "隔热", "耐高温"],
    "头部防护": ["安全帽", "头盔", "头部"],
    "听力防护": ["耳塞", "耳罩", "噪音", "噪声", "降噪"],
    "足部防护": ["安全鞋", "劳保鞋", "雨靴", "鞋"],
    "身体防护": ["防护服", "防化服", "工作服", "雨衣", "围裙", "反光"],
    "坠落防护": ["安全带", "安全绳", "高空", "坠落", "登高"]
  }
}
